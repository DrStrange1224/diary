<Window x:Class="Diary.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Diary"
        xmlns:scm="clr-namespace:System.ComponentModel;assembly=WindowsBase"
        mc:Ignorable="d"
        Title="DIARY" Height="600" Width="1000">

    <Window.Resources>
        <CollectionViewSource x:Key="EntriesView" Source="{Binding Entries}">
            <CollectionViewSource.SortDescriptions>
                <scm:SortDescription PropertyName="Day" Direction="Descending"/>
                <scm:SortDescription PropertyName="Date" Direction="Descending"/>
            </CollectionViewSource.SortDescriptions>
            <CollectionViewSource.GroupDescriptions>
                <PropertyGroupDescription PropertyName="Day"/>
            </CollectionViewSource.GroupDescriptions>
        </CollectionViewSource>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Text="Entries"
                       FontSize="20"
                       FontWeight="SemiBold"
                       Margin="0,0,0,8"/>

            <ListBox Grid.Row="1"
                     ItemsSource="{Binding Source={StaticResource EntriesView}}"
                     SelectedItem="{Binding SelectedEntry}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListBox.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.HeaderTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name, StringFormat='{}{0:dddd, MMMM d}'}"
                                           FontWeight="Bold"
                                           Foreground="CornflowerBlue"
                                           Margin="0,10,0,4"/>
                            </DataTemplate>
                        </GroupStyle.HeaderTemplate>
                    </GroupStyle>
                </ListBox.GroupStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="2,3">
                            <TextBlock Text="{Binding Title}"
                                       FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding Date, StringFormat='{}{0:HH:mm}'}"
                                       FontSize="11"
                                       Foreground="Gray"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>

        <Grid Grid.Column="1" Margin="16,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Text="Calendar"
                       FontSize="20"
                       FontWeight="SemiBold"
                       Margin="0,0,0,8"/>

            <Calendar Grid.Row="1"
                      SelectedDate="{Binding SelectedDate}"
                      FontSize="18"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"/>
        </Grid>
    </Grid>
</Window>