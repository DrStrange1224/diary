<Window x:Class="Diary.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Diary"
        xmlns:conv="clr-namespace:Diary.Converters"
        xmlns:scm="clr-namespace:System.ComponentModel;assembly=WindowsBase"
        mc:Ignorable="d"
        Title="DIARY" Height="600" Width="1000"
        ResizeMode="NoResize"
        Background="{DynamicResource Window.Background}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <conv:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis"/>
        <conv:EntryCountToBrushConverter x:Key="CountToBrush"/>
        <CollectionViewSource x:Key="EntriesView" Source="{Binding Entries}">
            <CollectionViewSource.SortDescriptions>
                <scm:SortDescription PropertyName="Day" Direction="Descending"/>
                <scm:SortDescription PropertyName="Date" Direction="Descending"/>
            </CollectionViewSource.SortDescriptions>
            <CollectionViewSource.GroupDescriptions>
                <PropertyGroupDescription PropertyName="Day"/>
            </CollectionViewSource.GroupDescriptions>
        </CollectionViewSource>
    </Window.Resources>

    <Grid Margin="12" TextElement.Foreground="{DynamicResource Text}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <ListBox Grid.Row="0"
                     Background="{DynamicResource Window.Background}"
                     Foreground="{DynamicResource Text}"
                     ItemsSource="{Binding Source={StaticResource EntriesView}}"
                     SelectedItem="{Binding SelectedEntry}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Foreground" Value="{DynamicResource Text}"/>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.GroupStyle>
                <GroupStyle>
                    <GroupStyle.HeaderTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name, StringFormat='{}{0:dddd, MMMM d}'}"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource Accent}"
                                       Margin="0,10,0,4"/>
                        </DataTemplate>
                    </GroupStyle.HeaderTemplate>
                </GroupStyle>
            </ListBox.GroupStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="2,3">
                        <TextBlock Text="{Binding Title}"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Date, StringFormat='{}{0:HH:mm}'}"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextSecondary}"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Border Grid.Row="1"
                BorderBrush="{DynamicResource Border}"
                BorderThickness="0,1,0,0"
                Padding="4,2">
            <StackPanel Orientation="Horizontal">
                <Button Content="&#x2B;"
                        Command="{Binding AddEntryCommand}"
                        Background="Transparent"
                        BorderThickness="0"
                        FontSize="18"
                        Foreground="{DynamicResource TextSecondary}"
                        Cursor="Hand"
                        ToolTip="Add note"/>
                <Button Content="&#x2699;"
                        Command="{Binding OpenSettingsCommand}"
                        Margin="8,0,0,0"
                        Background="Transparent"
                        BorderThickness="0"
                        FontSize="18"
                        Foreground="{DynamicResource TextSecondary}"
                        Cursor="Hand"
                        ToolTip="Settings"/>
            </StackPanel>
        </Border>
    </Grid>

        <Grid Grid.Column="1" Margin="16,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox Grid.Column="0"
                         Text="{Binding SelectedEntry.Title, UpdateSourceTrigger=PropertyChanged}"
                         FontSize="20"
                         FontWeight="SemiBold"
                         Background="Transparent"
                         BorderThickness="1"
                         BorderBrush="{DynamicResource Border}"
                         CaretBrush="{DynamicResource Text}"
                         Foreground="{DynamicResource Text}"
                         Padding="2"
                         TextWrapping="Wrap"
                         AcceptsReturn="False"
                         VerticalAlignment="Center"
                         Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}"/>

                <Button Grid.Column="1"
                        Content="&#x2715;"
                        Margin="8,0,0,0"
                        VerticalAlignment="Top"
                        Background="Transparent"
                        BorderThickness="0"
                        FontSize="16"
                        Foreground="{DynamicResource TextSecondary}"
                        Cursor="Hand"
                        ToolTip="Close entry"
                        Command="{Binding CloseEntryCommand}"
                        Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}"/>
            </Grid>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="25*"/>
                    <ColumnDefinition Width="50*"/>
                    <ColumnDefinition Width="25*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="15*"/>
                    <RowDefinition Height="70*"/>
                    <RowDefinition Height="15*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0"
                              Grid.RowSpan="3"
                              Grid.Column="0"
                              Grid.ColumnSpan="3"
                              Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,4,8,12">
                        <Border CornerRadius="10"
                                Padding="10,3"
                                Margin="0,0,8,0"
                                Background="{DynamicResource Panel.Background}"
                                BorderBrush="{DynamicResource Border}"
                                BorderThickness="1">
                            <TextBlock FontSize="12"
                                       Foreground="{DynamicResource TextSecondary}">
                                <Run Text="Created: "/>
                                <Run Text="{Binding SelectedEntry.CreatedAt, Mode=OneWay, StringFormat='{}{0:dd MMM yyyy, HH:mm}'}"/>
                            </TextBlock>
                        </Border>
                    </StackPanel>

                    <TextBox Grid.Row="1"
                             Text="{Binding SelectedEntry.Content, UpdateSourceTrigger=PropertyChanged}"
                             FontSize="15"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto"
                             Background="Transparent"
                             BorderThickness="1"
                             BorderBrush="{DynamicResource Border}"
                             CaretBrush="{DynamicResource Text}"
                             Foreground="{DynamicResource Text}"
                             Padding="2"/>
                </Grid>

                <Grid Grid.Row="1"
                     Grid.Column="1"
                     Visibility="{Binding HasSelection, Converter={StaticResource InverseBoolToVis}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="{Binding MonthTitle}"
                               FontWeight="Bold"
                               FontSize="16"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Margin="0,0,0,8"/>

                    <ItemsControl Grid.Row="1"
                                  ItemsSource="{Binding DayHeaders}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="7"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}"
                                           HorizontalAlignment="Center"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextSecondary}"
                                           Padding="0,4"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <ItemsControl Grid.Row="2"
                                  ItemsSource="{Binding Days}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="7"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Command="{Binding DataContext.SelectDateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding Date}"
                                        Margin="1">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Background" Value="{Binding NoteCount, Converter={StaticResource CountToBrush}}"/>
                                            <Setter Property="BorderBrush" Value="{DynamicResource DayBorder}"/>
                                            <Setter Property="BorderThickness" Value="0.5"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsToday}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource Today}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <TextBlock Text="{Binding DayNumber}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               FontSize="14">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsCurrentMonth}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource Text}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsToday}" Value="True">
                                                        <Setter Property="Foreground" Value="White"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>