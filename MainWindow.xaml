<Window x:Class="Diary.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Diary"
        xmlns:conv="clr-namespace:Diary.Converters"
        xmlns:scm="clr-namespace:System.ComponentModel;assembly=WindowsBase"
        mc:Ignorable="d"
        Title="DIARY" Height="600" Width="1000"
        ResizeMode="NoResize"
        FontSize="13"
        Background="{DynamicResource Window.Background}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <conv:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis"/>
        <conv:EntryCountToBrushConverter x:Key="CountToBrush"/>
        <CollectionViewSource x:Key="EntriesView" Source="{Binding Entries}">
            <CollectionViewSource.SortDescriptions>
                <scm:SortDescription PropertyName="Day" Direction="Descending"/>
                <scm:SortDescription PropertyName="Date" Direction="Descending"/>
            </CollectionViewSource.SortDescriptions>
            <CollectionViewSource.GroupDescriptions>
                <PropertyGroupDescription PropertyName="DayLabel"/>
            </CollectionViewSource.GroupDescriptions>
        </CollectionViewSource>
    </Window.Resources>

    <Grid Margin="16" TextElement.Foreground="{DynamicResource Text}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="{DynamicResource Surface}"
                    CornerRadius="12"
                    Padding="6"
                    Margin="0,0,0,10">
                <ListBox Background="Transparent"
                         BorderThickness="0"
                         Foreground="{DynamicResource Text}"
                         ItemsSource="{Binding Source={StaticResource EntriesView}}"
                         SelectedItem="{Binding SelectedEntry}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Items[0].DayLabel}"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextSecondary}"
                                               Margin="8,14,0,6"/>
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ListBox.GroupStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,1">
                                <TextBlock Text="{Binding Title}"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding Date, StringFormat='{}{0:HH:mm}'}"
                                           FontSize="11"
                                           Foreground="{DynamicResource TextSecondary}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <Border Grid.Row="1"
                    Background="{DynamicResource Surface}"
                    CornerRadius="12"
                    Padding="10,4">
                <StackPanel Orientation="Horizontal">
                    <Button Content="&#x2B;"
                            Command="{Binding AddEntryCommand}"
                            Background="Transparent"
                            BorderThickness="0"
                            FontSize="26"
                            Foreground="{DynamicResource TextSecondary}"
                            ToolTip="{Binding Strings.AddNote}"/>
                    <Button Content="&#x2699;"
                            Command="{Binding OpenSettingsCommand}"
                            Margin="10,0,0,0"
                            Background="Transparent"
                            BorderThickness="0"
                            FontSize="26"
                            Foreground="{DynamicResource TextSecondary}"
                            ToolTip="{Binding Strings.Settings}"/>
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Column="1" Margin="10,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox Grid.Column="0"
                         Text="{Binding SelectedEntry.Title, UpdateSourceTrigger=PropertyChanged}"
                         FontSize="21"
                         FontWeight="SemiBold"
                         Background="Transparent"
                         BorderThickness="1"
                         BorderBrush="{DynamicResource Border}"
                         Padding="10,8"
                         TextWrapping="Wrap"
                         AcceptsReturn="False"
                         VerticalAlignment="Center"
                         VerticalContentAlignment="Center"
                         Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}"/>

                <Button Grid.Column="1"
                        Content="&#x2715;"
                        Margin="10,0,0,0"
                        Padding="8,4"
                        VerticalAlignment="Top"
                        BorderThickness="0"
                        FontSize="14"
                        Foreground="{DynamicResource TextSecondary}"
                        ToolTip="{Binding Strings.CloseEntry}"
                        Command="{Binding CloseEntryCommand}"
                        Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}"/>
            </Grid>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="25*"/>
                    <ColumnDefinition Width="50*"/>
                    <ColumnDefinition Width="25*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="15*"/>
                    <RowDefinition Height="70*"/>
                    <RowDefinition Height="15*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0"
                      Grid.RowSpan="3"
                      Grid.Column="0"
                      Grid.ColumnSpan="3"
                      Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="2,2,8,12">
                        <Border CornerRadius="12"
                                Padding="12,6"
                                Margin="0,0,8,0"
                                Background="{DynamicResource Panel.Background}"
                                BorderBrush="{DynamicResource Border}"
                                BorderThickness="1">
                            <TextBlock FontSize="12"
                                       Foreground="{DynamicResource TextSecondary}"
                                       Text="{Binding SelectedEntry.CreatedLabel, Mode=OneWay}"/>
                        </Border>
                    </StackPanel>

                    <TextBox Grid.Row="1"
                             Text="{Binding SelectedEntry.Content, UpdateSourceTrigger=PropertyChanged}"
                             FontSize="15"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto"
                             Padding="10,8"
                             VerticalContentAlignment="Top"
                             Background="Transparent"
                             BorderBrush="{DynamicResource Border}"/>
                </Grid>

                <Grid Grid.Row="1"
                     Grid.Column="1"
                     Visibility="{Binding HasSelection, Converter={StaticResource InverseBoolToVis}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="{Binding MonthTitle}"
                               FontWeight="SemiBold"
                               FontSize="16"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource Text}"
                               Margin="0,0,0,10"/>

                    <ItemsControl Grid.Row="1"
                                  ItemsSource="{Binding DayHeaders}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="7"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}"
                                           HorizontalAlignment="Center"
                                           FontWeight="SemiBold"
                                           FontSize="11"
                                           Foreground="{DynamicResource TextSecondary}"
                                           Padding="0,6"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <ItemsControl Grid.Row="2"
                                  ItemsSource="{Binding Days}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="7"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Command="{Binding DataContext.SelectDateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding Date}"
                                        Margin="3">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource RoundButton}">
                                            <Setter Property="Background" Value="{Binding NoteCount, Converter={StaticResource CountToBrush}}"/>
                                            <Setter Property="BorderBrush" Value="{DynamicResource DayBorder}"/>
                                            <Setter Property="BorderThickness" Value="0.5"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsToday}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource Today}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <TextBlock Text="{Binding DayNumber}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               FontSize="14">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsCurrentMonth}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource Text}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsToday}" Value="True">
                                                        <Setter Property="Foreground" Value="White"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>